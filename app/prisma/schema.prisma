generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  dailyInputs DailyInput[]
  goals       Goal[]

  @@map("users")
}

model DailyInput {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  targetDate    DateTime @map("target_date")
  doneToday     String   @map("done_today")
  concerns      String   @default("")
  planTomorrow  String   @default("") @map("plan_tomorrow")
  memo          String   @default("")
  inputSource   String   @default("web") @map("input_source")
  status        String   @default("draft")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  aiAnalysis AiAnalysis?

  @@unique([userId, targetDate])
  @@index([userId])
  @@index([status])
  @@map("daily_inputs")
}

model AiAnalysis {
  id                  String  @id @default(uuid())
  dailyInputId        String  @unique @map("daily_input_id")
  dailyReport         String  @map("daily_report")
  priorities          String  @default("[]")
  risks               String  @default("[]")
  consultationNeeded  Boolean @default(false) @map("consultation_needed")
  consultationTarget  String? @map("consultation_target")
  consultationReason  String? @map("consultation_reason")
  nextActions         String  @default("[]") @map("next_actions")
  rawResponse         String? @map("raw_response")
  modelVersion        String  @map("model_version")
  createdAt           DateTime @default(now()) @map("created_at")

  dailyInput          DailyInput          @relation(fields: [dailyInputId], references: [id], onDelete: Cascade)
  consultationDrafts  ConsultationDraft[]
  goalContributions   GoalContribution[]

  @@map("ai_analyses")
}

model ConsultationDraft {
  id             String @id @default(uuid())
  aiAnalysisId   String @map("ai_analysis_id")
  targetRole     String @map("target_role")
  draftText      String @map("draft_text")
  contextSummary String? @map("context_summary")
  createdAt      DateTime @default(now()) @map("created_at")

  aiAnalysis AiAnalysis @relation(fields: [aiAnalysisId], references: [id], onDelete: Cascade)

  @@map("consultation_drafts")
}

model Goal {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  title       String
  description String   @default("")
  periodStart DateTime @map("period_start")
  periodEnd   DateTime @map("period_end")
  status      String   @default("active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  contributions GoalContribution[]

  @@index([userId, status])
  @@map("goals")
}

model GoalContribution {
  id               String   @id @default(uuid())
  goalId           String   @map("goal_id")
  aiAnalysisId     String   @map("ai_analysis_id")
  contributionNote String   @map("contribution_note")
  alignmentScore   Int      @map("alignment_score")
  createdAt        DateTime @default(now()) @map("created_at")

  goal       Goal       @relation(fields: [goalId], references: [id], onDelete: Cascade)
  aiAnalysis AiAnalysis @relation(fields: [aiAnalysisId], references: [id], onDelete: Cascade)

  @@unique([goalId, aiAnalysisId])
  @@map("goal_contributions")
}
